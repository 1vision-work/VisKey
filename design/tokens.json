      "light": "#DDE2FF",
      "dark": "#262D6B"
    },
    "warning": {
      "light": "#B45309",
      "dark": "#F5A65B",
      "contrast": "5.0 / 8.9",
      "use": "Chấm thiếu quyền, xung đột bộ gõ"
    },
    "error": {
      "light": "#C2302A",
      "dark": "#FF8A80",
      "contrast": "5.6 / 7.8",
      "use": "Nút Khôi phục toàn bộ cài đặt…"
    }
