      "600": "#4B515C",
      "700": "#343841",
      "850": "#1F2226",
      "900": "#16181C"
    },
    "warning": {
      "label": "Cảnh báo",
      "base": "#B45309",
      "dark": "#F5A65B"
    },
    "error": {
      "label": "Lỗi / huỷ",
      "base": "#C2302A",
      "dark": "#FF8A80"
    }
  },
  "semantic": {
    "bg": {
      "light": "#FFFFFF",
      "dark": "#16181C",
      "use": "Nền cửa sổ onboarding / website"
    },
    "surface": {
      "light": "#F6F7F9",
      "dark": "#1F2226",
      "use": "Thẻ trong onboarding; nền cửa sổ Cài đặt dùng window-bg"
