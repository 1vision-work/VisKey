    },
    "text-secondary": {
      "light": "#666D7A",
      "dark": "#A3A9B5",
      "contrast": "5.2 / 6.8"
    },
    "primary": {
      "light": "#3044D6",
      "dark": "#8193FF",
      "use": "Chữ, liên kết, viền chọn và focus, giá trị đã chỉnh",
      "contrast": "6.6 / 5.7 (UI spec); 7.2 / 6.4 (brand v1)"
    },
    "on-primary": {
      "light": "#FFFFFF",
      "dark": "#FFFFFF",
      "use": "Chữ trên primary-fill"
    },
    "accent-text": {
      "light": "#0B7F6D",
      "dark": "#3FE0C0",
      "contrast": "4.9 / 10.7"
    },
    "accent-graphic": {
      "light": "#14B89A",
      "dark": "#3FE0C0",
      "use": "Chỉ cho hình: dấu ✓, dấu mũ trong logo"
    }
  },
  "ui": {
    "window-bg": {
      "light": "#F6F7F9",
      "dark": "#16181C",
      "use": "Settings, công cụ chuyển mã, cập nhật"
    },
    "group-bg": {
      "light": "#FFFFFF",
      "dark": "#1F2226",
      "use": "Form section, bảng, khối mã"
    },
    "separator": {
      "light": "#E3E5EA",
      "dark": "#2E3238",
      "use": "Đường kẻ 0,5 pt"
    },
    "control-bg": {
      "light": "#FFFFFF",
      "dark": "#343841",
      "use": "Popup, nút, ô ghi phím"
    },
    "control-border": {
      "light": "#C9CCD4",
      "dark": "#4B515C"
    },
    "toggle-off": {
      "light": "#D3D6DD",
      "dark": "#4B515C"
    },
    "primary-fill": {
      "light": "#3044D6",
      "dark": "#4C60F5",
