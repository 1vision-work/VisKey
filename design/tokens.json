      "400": "#8193FF",
      "500": "#4C60F5",
      "600": "#3044D6",
      "700": "#2534B8",
      "900": "#141C66",
      "notes": {
        "600": "gốc (light)",
        "400": "bản dùng cho chữ/viền trong dark mode"
      }
    },
    "jade": {
      "label": "Ngọc (accent)",
      "100": "#D5F8F0",
      "300": "#7BEDD5",
      "400": "#3FE0C0",
      "500": "#14B89A",
      "700": "#0B7F6D",
      "900": "#064A40",
      "notes": {
        "400": "gốc, cũng là bản dark",
        "500": "chỉ cho đồ hoạ, không cho chữ (2,5:1 trên trắng)"
      }
    },
    "charcoal": {
      "label": "Xám than (neutral)",
      "0": "#FFFFFF",
      "50": "#F6F7F9",
      "100": "#ECEEF2",
      "200": "#DADDE4",
