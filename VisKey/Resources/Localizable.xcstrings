{
  "sourceLanguage": "vi",
  "strings": {
    "Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Trợ năng": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings › Privacy & Security › Accessibility"
          }
        }
      }
    },
    "Cần quyền Trợ năng để nhận phím bạn gõ. VisKey không lưu hay gửi nội dung này đi đâu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission lets VisKey receive the keys you type. VisKey never stores or sends them anywhere."
          }
        }
      }
    },
    "Kiểu gõ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input method"
          }
        }
      }
    },
    "Mở Cài đặt hệ thống": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        }
      }
    },
